# Anthropic API Key (obrigatório)
# Obtenha em: https://console.anthropic.com
REACT_APP_ANTHROPIC_API_KEY=sk-ant-...

# Read AI API Key (opcional — enriquece briefings com histórico de reuniões)
# Obtenha em: app.read.ai → Settings → API
REACT_APP_READ_AI_KEY=
